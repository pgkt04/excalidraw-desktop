{
  "name": "excalidraw",
  "productName": "Excalidraw",
  "version": "1.0.11",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build:excalidraw": "node scripts/build-excalidraw.js",
    "dist": "npm run build:excalidraw && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:win": "npm run build:excalidraw && electron-builder --win",
    "dist:mac": "npm run build:excalidraw && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:linux": "npm run build:excalidraw && electron-builder --linux",
    "dist:appimage": "npm run build:excalidraw && electron-builder --linux AppImage",
    "dist:deb": "npm run build:excalidraw && electron-builder --linux deb"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Excalidraw desktop application for Linux, Windows, and Mac.",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.excalidraw",
    "productName": "Excalidraw",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "app-bundle/**/*",
      "node_modules/**/*",
      "sidebar/**/*",
      "dialogs/**/*",
      "index.js",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Excalidraw.Drawing",
        "description": "Excalidraw drawing file",
        "mimeType": "application/json",
        "role": "Editor",
        "icon": "icon2.ico"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon2.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "maintainer": "WeWeBunnyX <145664273+WeWeBunnyX@users.noreply.github.com>"
    }
  }
}
